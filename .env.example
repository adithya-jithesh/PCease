# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Used for the canonical site URL in OAuth redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AI Studio key (https://aistudio.google.com/apikey). Powers the AI
# advisor chat and the automatic price updates. The budget planner works without it.
GEMINI_API_KEY=

# --- Price updates (server only, never expose these) ---
# Supabase → Project Settings → API keys → secret key (or the legacy service_role key).
# Lets the price job and admin page write prices; it bypasses row-level security.
SUPABASE_SECRET_KEY=

# Random string Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Comma-separated emails allowed to open /admin/prices.
ADMIN_EMAILS=

# --- Optional: Gemini model lists, best first (defaults in src/lib/ai.ts) ---
# Override when Google retires a model: https://ai.google.dev/gemini-api/docs/models
# GEMINI_CHAT_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_PRICE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
